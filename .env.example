# Local Docker Compose configuration (copy to .env; never commit secrets)
# Fake provider is the default; no Anthropic charges.
LLM_PROVIDER=fake

# To explicitly enable Claude, change LLM_PROVIDER=claude and provide both values.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_MAX_TOKENS=512

# Per-IP hourly request limit and total simultaneous generations.
GENERATION_MAX_REQUESTS_PER_HOUR=10
GENERATION_MAX_CONCURRENT=2
